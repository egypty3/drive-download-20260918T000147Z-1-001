    <Item1 Ref="13" Name="GroupQuotOrder" FieldType="String" Expression="Substring([QuotationOrder], 0, 1)" DataMember="Query" />
    <Item2 Ref="14" Name="GroupHeader" FieldType="String" Expression="Iif ([GroupQuotOrder] = 1, 'AIRPORT CHARGES' , &#xA;Iif([GroupQuotOrder] = 2 , 'RAMP HANDLING CHARGES' , &#xA;Iif([GroupQuotOrder] = 3 , 'TAS CHARGES' , &#xA;Iif([GroupQuotOrder] = 4 , 'On Request Services' , &#xA;Iif([GroupQuotOrder] = 5 , 'Ramp Handling Equipment Provider Promotional Discount Till End of October 2021' , &#xA;Iif([GroupQuotOrder] = 6 , 'On Request Extra Equipment (If Used)' , &#xA;Iif([GroupQuotOrder] = 7 , 'Group 7 Header Title' , &#xA;Iif([GroupQuotOrder] = 8 , 'Other' , &#xA;'Not Set'))))))))" DataMember="Query" />
    <Item3 Ref="15" Name="RefNo" FieldType="String" Expression="'Ref.No   ' + [CustomerCode] + '/' + &#xA;FormatString([yy],GetYear(GetDate(Now())))" DataMember="Query" />
    <Item4 Ref="16" Name="DisbursementAmt" Expression="&#xA;&#xA;Iif([DisbursementType] ,&#xA;Sum([FinalPrice] * [ServiceQuantity])*([Disbursement]/100),[Disbursement])" DataMember="Query" />
    <Item5 Ref="17" Name="DiscountAmt" Expression="Iif([DiscountOnTotal],sum([DiscountAmount]),&#xA;Iif([DiscountType] ,&#xA;(Sum([FinalPrice] * [ServiceQuantity])+[DiscountAmt])*([Discount]/100),[Discount]))&#xA;" DataMember="Query" />
    <Item6 Ref="18" Name="NetAmt" Expression="sum([FinalPrice]*[ServiceQuantity])+[DisbursementAmt]-[DiscountAmt]" DataMember="Query" />
  </CalculatedFields>
