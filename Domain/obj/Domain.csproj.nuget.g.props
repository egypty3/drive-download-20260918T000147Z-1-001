<?xml version="1.0" encoding="utf-8" standalone="no"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <RestoreSuccess Condition=" '$(RestoreSuccess)' == '' ">True</RestoreSuccess>
    <RestoreTool Condition=" '$(RestoreTool)' == '' ">NuGet</RestoreTool>
    <ProjectAssetsFile Condition=" '$(ProjectAssetsFile)' == '' ">$(MSBuildThisFileDirectory)project.assets.json</ProjectAssetsFile>
    <NuGetPackageRoot Condition=" '$(NuGetPackageRoot)' == '' ">/Users/tarekmostafa/.nuget/packages/</NuGetPackageRoot>
    <NuGetPackageFolders Condition=" '$(NuGetPackageFolders)' == '' ">/Users/tarekmostafa/.nuget/packages/</NuGetPackageFolders>
    <NuGetProjectStyle Condition=" '$(NuGetProjectStyle)' == '' ">PackageReference</NuGetProjectStyle>
    <NuGetToolVersion Condition=" '$(NuGetToolVersion)' == '' ">7.0.0</NuGetToolVersion>
  </PropertyGroup>
  <ItemGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <SourceRoot Include="/Users/tarekmostafa/.nuget/packages/" />
  </ItemGroup>
  <ImportGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <Import Project="$(NuGetPackageRoot)microsoft.entityframeworkcore/8.0.11/buildTransitive/net8.0/Microsoft.EntityFrameworkCore.props" Condition="Exists('$(NuGetPackageRoot)microsoft.entityframeworkcore/8.0.11/buildTransitive/net8.0/Microsoft.EntityFrameworkCore.props')" />
    <Import Project="$(NuGetPackageRoot)devexpress.blazor.themes.fluent/25.1.3/buildTransitive/DevExpress.Blazor.Themes.Fluent.props" Condition="Exists('$(NuGetPackageRoot)devexpress.blazor.themes.fluent/25.1.3/buildTransitive/DevExpress.Blazor.Themes.Fluent.props')" />
    <Import Project="$(NuGetPackageRoot)devexpress.blazor.themes/25.1.3/buildTransitive/DevExpress.Blazor.Themes.props" Condition="Exists('$(NuGetPackageRoot)devexpress.blazor.themes/25.1.3/buildTransitive/DevExpress.Blazor.Themes.props')" />
    <Import Project="$(NuGetPackageRoot)devexpress.blazor.resources/25.1.3/buildTransitive/DevExpress.Blazor.Resources.props" Condition="Exists('$(NuGetPackageRoot)devexpress.blazor.resources/25.1.3/buildTransitive/DevExpress.Blazor.Resources.props')" />
    <Import Project="$(NuGetPackageRoot)devexpress.blazor/25.1.3/buildTransitive/net5.0/DevExpress.Blazor.props" Condition="Exists('$(NuGetPackageRoot)devexpress.blazor/25.1.3/buildTransitive/net5.0/DevExpress.Blazor.props')" />
  </ImportGroup>
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <PkgDevExpress_Data Condition=" '$(PkgDevExpress_Data)' == '' ">/Users/tarekmostafa/.nuget/packages/devexpress.data/25.1.3</PkgDevExpress_Data>
    <PkgDevExpress_Xpo Condition=" '$(PkgDevExpress_Xpo)' == '' ">/Users/tarekmostafa/.nuget/packages/devexpress.xpo/25.1.3</PkgDevExpress_Xpo>
    <PkgDevExpress_DataAccess Condition=" '$(PkgDevExpress_DataAccess)' == '' ">/Users/tarekmostafa/.nuget/packages/devexpress.dataaccess/25.1.3</PkgDevExpress_DataAccess>
  </PropertyGroup>
</Project>